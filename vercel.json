{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/google-callback", "destination": "/api/auth-notify?action=google-callback" }
  ],
  "functions": {
    "api/translate.js": { "maxDuration": 30 },
    "api/transcribe.js": { "maxDuration": 300 },
    "api/meeting-segment.js": { "maxDuration": 30 },
    "api/v1/translate.js": { "maxDuration": 30 },
    "api/v1/transcribe.js": { "maxDuration": 30 },
    "api/v1/talk-session.js": { "maxDuration": 20 }
  }
}
