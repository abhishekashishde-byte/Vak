# Existing Ana / Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# OpenAI
OPENAI_API_KEY=

# Ana admin login/signup notifications and review moderation
# Keep these server-side only. Do not prefix them with VITE_.
RESEND_API_KEY=
ANA_ADMIN_EMAIL=
ANA_NOTIFY_FROM="Ana Notifications <notifications@tri-vana.de>"

# Gmail connection for sending reviewed meeting MOM emails
# Create a Google OAuth Web application and enable the Gmail API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="https://vak-gray.vercel.app/api/google-callback"
GOOGLE_APP_URL="https://vak-gray.vercel.app"
# Optional extra encryption secret. If omitted, GOOGLE_CLIENT_SECRET is used.
GOOGLE_TOKEN_SECRET=

# Ana Platform private beta
# Comma-separated server API keys accepted by /api/v1/*.
# Leave blank to keep all external platform endpoints disabled.
ANA_PLATFORM_API_KEYS=
# Optional comma-separated browser origins. Prefer calling Ana Platform from a partner backend.
ANA_PLATFORM_ALLOWED_ORIGINS=
